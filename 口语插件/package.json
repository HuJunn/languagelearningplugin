{
  "name": "yt-shadowing",
  "description": "口语跟读：字幕列表、逐词渐变、点词翻译、读完自动暂停",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt -b edge",
    "build": "wxt build -b edge",
    "zip": "wxt zip -b edge",
    "build:mobile": "wxt zip -b edge && node scripts/pack-crx.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "build:dict": "node scripts/build-dict.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
